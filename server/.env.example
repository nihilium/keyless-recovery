# Copy to .env and fill in. Never commit .env.
#
# This process is ONLY a transaction relayer. The recovery ceremony (sealing, the email round trip,
# unsealing, signing the intent) runs in the browser — see the root README. That's why there is no
# Nihilium API key and no Privy app secret here any more.

PORT=8787
NETWORK_ID=11155111
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Pays gas for initiateRecovery/executeRecovery on behalf of a user who has none. The module is
# built for this: "anyone may submit — the authority is the signature, not the sender."
# Generate: node -e "console.log(require('viem/accounts').generatePrivateKey())"
RELAYER_PRIVATE_KEY=

# The graduated veto's three separated authorities. pause/abort are msg.sender-gated on-chain, so
# these keys cannot live in a browser. Hold them on three different parties in a real deployment.
GUARDIAN_PAUSE_KEY=
GUARDIAN_ABORT_KEY=
GUARDIAN_RESUME_KEY=

# Gates /api/admin/* (the recovery-watching dashboard at /admin).
ADMIN_TOKEN=

# Floor for on-chain event scans — RecoveryModule's Sepolia deployment block.
DEPLOYMENT_BLOCK=11652963

# Demo veto timing, in blocks (~12s each). Small on purpose for a live demo.
TIMELOCK_BLOCKS=5
PAUSE_CEILING_BLOCKS=20
