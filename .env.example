# Copy to .env.local and fill in to use real Privy login instead of the
# local dev identity fallback (see src/auth/login.ts).
#
# Only the app ID belongs here — the app secret must never be VITE_-prefixed (see server/.env.example).
VITE_PRIVY_APP_ID=
# Where the backend (server/) is running. Only needed once NihiliumRecoveryProvider is bound.
VITE_RECOVERY_BACKEND_URL=http://localhost:8787
# "fictive" (default) or "nihilium" — see README "Going live".
VITE_RECOVERY_PROVIDER=fictive
# Nihilium (client-side — the ceremony runs in the browser).
VITE_NIHILIUM_API_KEY=
VITE_NIHILIUM_API_URL=https://api.nihilium.io
VITE_NIHILIUM_EMAIL_SERVICE_URL=https://zkemail.nihilium.io
VITE_NIHILIUM_THRESHOLD=1
VITE_NIHILIUM_PROCESSOR_COUNT=1
